{
  "fields": {
    "text_001": "",
    "text_002": "",
    "text_003": "월간 독서·논술 리포트",
    "text_004": "읽고, 생각하고,\n표현한 한 달",
    "text_005": "아이의 말과 글에 담긴 작은 변화를 함께 읽습니다.",
    "text_006": "",
    "text_007": "",
    "text_008": "",
    "text_009": "",
    "text_010": "02",
    "text_011": "한눈에 보는 이번 달의 성장",
    "text_012": "",
    "text_013": "이번 달의 핵심 변화",
    "text_014": "",
    "text_015": "",
    "text_016": "달라진 모습",
    "text_017": "",
    "text_018": "이어지는 강점",
    "text_019": "",
    "text_020": "다음 확인",
    "text_021": "",
    "text_022": "판단의 근거",
    "text_023": "",
    "text_024": "",
    "text_025": "",
    "text_026": "",
    "text_027": "03",
    "text_028": "영역별 관찰과 변화",
    "text_029": "날짜가 있는 말·글·행동을 바탕으로 정리한 학습 모습",
    "text_030": "관찰이 남은 날짜",
    "text_031": "",
    "text_032": "",
    "text_033": "",
    "text_034": "",
    "text_035": "내용 이해",
    "text_036": "해석·추론",
    "text_037": "관점 확장",
    "text_038": "주장·근거",
    "text_039": "글의 구성",
    "text_040": "퇴고·성찰",
    "text_041": "관련 관찰 기록 있음",
    "text_042": "해당 날짜의 근거 없음",
    "text_043": "표식은 기록의 존재를 뜻하며, 개수는 성장 점수가 아닙니다.",
    "text_044": "기록에서 확인한 모습",
    "text_045": "",
    "text_046": "",
    "text_047": "",
    "text_048": "",
    "text_049": "",
    "text_050": "",
    "text_051": "04",
    "text_052": "작품으로 확인하는 변화",
    "text_053": "",
    "text_054": "",
    "text_055": "",
    "text_056": "",
    "text_057": "",
    "text_058": "",
    "text_059": "",
    "text_060": "달라진 표현",
    "text_061": "",
    "text_062": "교사의 도움",
    "text_063": "",
    "text_064": "판단의 범위",
    "text_065": "",
    "text_066": "05",
    "text_067": "다음 달 지도와 가정 연계",
    "text_068": "한 가지 목표로 이어지는 학원의 지도와 가정의 실천",
    "text_069": "다음 달의 한 가지 목표",
    "text_070": "",
    "text_071": "발견한 모습",
    "text_072": "",
    "text_073": "지도 방법",
    "text_074": "",
    "text_075": "확인할 결과",
    "text_076": "",
    "text_077": "집에서 함께하는 5~10분",
    "text_078": "",
    "text_079": "",
    "text_080": "주 1회 제안 · 가정 상황에 맞게 조절",
    "text_081": "A LETTER TO YOU",
    "text_082": "아이의 생각이 자라는 곁에서",
    "text_083": "학부모님께",
    "text_084": "",
    "text_085": "",
    "text_086": "",
    "text_087": "",
    "text_088": "",
    "text_089": "아이의 배움을 함께 응원하며,",
    "text_090": "원장 드림",
    "text_091": "",
    "text_092": "배움의 기록을\n준비하는 한 달",
    "text_093": "",
    "text_094": "현재 기록 상태 안내",
    "text_095": "이번 달 학습 기록 안내",
    "text_096": "",
    "text_097": "",
    "text_098": "",
    "text_099": "등록된 기록",
    "text_100": "",
    "text_101": "날짜 있는 기록",
    "text_102": "",
    "text_103": "완료 상태 기록",
    "text_104": "기록 준비 상태",
    "text_105": "",
    "text_106": "",
    "text_107": "",
    "text_108": "가정에서 나누는 독서 대화",
    "text_109": "개인 성장 평가와 구별한 일반 활동 제안",
    "text_110": "주 1회, 5~10분 제안",
    "text_111": "",
    "text_112": "부모님의 질문",
    "text_113": "",
    "text_114": "아이를 돕는 방법",
    "text_115": "",
    "text_116": "다음 기록 준비",
    "text_117": "",
